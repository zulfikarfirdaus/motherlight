{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motherlight",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    // Serve /kontak directly instead of 307-ing to /kontak/, so the URL Google
    // crawls matches the canonical tag, the sitemap, and the internal links.
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "motherlight.co.id", "custom_domain": true },
    { "pattern": "www.motherlight.co.id", "custom_domain": true }
  ]
}
