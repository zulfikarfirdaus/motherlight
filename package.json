{
  "name": "motherlight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:vite": "vite",
    "build": "vite build && node scripts/prerender.js",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "gallery:login": "node scripts/sync-gallery.js --login",
    "gallery:sync": "node scripts/sync-gallery.js",
    "gallery:thumbs": "node scripts/sync-gallery.js --thumbs",
    "gallery:albums": "node scripts/sync-gallery.js --albums",
    "migrate:supabase": "node migrate-to-supabase.js",
    "automate:full": "npx playwright test tests/automate-supabase-setup.spec.js --headed",
    "build:only": "vite build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.42.1",
    "multer": "^2.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.10"
  }
}
